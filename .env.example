ORCHESTRATOR_HOST=127.0.0.1
GAS_AGENT_HOST=127.0.0.1
FOOD_AGENT_HOST=127.0.0.1
PARKING_AGENT_HOST=127.0.0.1
WEATHER_AGENT_HOST=127.0.0.1

ORCHESTRATOR_PORT=9999
GAS_AGENT_PORT=9998
FOOD_AGENT_PORT=9997
PARKING_AGENT_PORT=9996
WEATHER_AGENT_PORT=9995

SERVER_PORT = 8000
SERVER_HOST=127.0.0.1
A2A_BIND_HOST=127.0.0.1

# set to 'true' to run all agents under a single Starlette application
# set to 'false' to run agents as standalone microservices on individual ports
SINGLE_APP_MODE=true

# set to 'true' to run sub-agents in offline mock mode
MOCK_MODE=false

OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_places_api_key
HERE_API_KEY=your_here_api_key
WEATHER_API_KEY=your_weather_api_key

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com


# Execution time limits (seconds)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
EXTERNAL_API_TIMEOUT_SECONDS=15
SUB_AGENT_TIMEOUT_SECONDS=90
# Left unset on purpose: the outer cap is derived from MAX_TASKS and
# SUB_AGENT_TIMEOUT_SECONDS so it cannot fire before the per-agent ones.
# Set it only to impose a hard ceiling shorter than that.
# REQUEST_TIMEOUT_SECONDS=180

# Loop limits
MAX_TASKS=5

# Routing limits
# Cosine similarity below which no agent is considered a match, so the request
# is refused instead of answered by whichever agent was nearest. Calibrate it:
# set it to 0 to see every query reach an agent, then raise it until the ones
# no agent covers stop getting through.
MIN_SKILL_SCORE=0.2

# Budget limits
# Limits the maximum number of output tokens generated in each individual LLM call (not the total request budget).
LLM_MAX_OUTPUT_TOKENS=1000
